# RetailPulse configuration. Copy to .env for local use (no secrets are needed).
# Data source: auto = real files in data/raw/ or download, else synthetic demo;
#              real = fail if real data is unavailable; synthetic = always demo data
RP_DATA_MODE=auto
# Try to download FreshRetailNet-50K from Hugging Face when no local files exist
RP_ALLOW_DOWNLOAD=true
# "auto" picks a representative store (many products, moderate stockout rate)
RP_STORE_ID=auto
# Paths (defaults shown)
# RP_RAW_DIR=data/raw
# RP_OUTPUT_DIR=outputs
# Analysis thresholds (design choices, documented in README)
RP_STOCKOUT_DAY_HOURS=8
RP_RISK_EVENT_HOURS=4
RP_ANOMALY_Z=3
RP_SEED=2026
# Web server port (Render sets this automatically)
PORT=3838
# Docker build: true = re-run the analysis instead of using the committed outputs/
RP_REBUILD=false
# Extra stores analysed when RP_REBUILD=true (space separated)
RP_EXTRA_STORES="235 263"
# Stores kept in memory by the web app (1 = lowest memory use)
RP_STORE_CACHE=2
